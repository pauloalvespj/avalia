# Copie este arquivo para .env.local e preencha com suas credenciais do Supabase.
# Project Settings → API no painel do Supabase.
#
# A ANON KEY é pública por design — pode ficar aqui.
# NUNCA coloque a chave service_role neste arquivo.

VITE_SUPABASE_URL=COLE_AQUI_SEU_PROJECT_URL
VITE_SUPABASE_ANON_KEY=COLE_AQUI_SUA_ANON_KEY
